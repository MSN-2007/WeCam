{
  "manifest_version": 3,
  "name": "CAMU AutoPass – V3.5",
  "version": "3.5.0",
  "description": "Cross-browser CAMU weekend leave and gate-pass automation (Chrome & Firefox) with React-Select detection, semantic time validation, and Thursday scheduling.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://student.camu.in/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CAMU AutoPass"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "camu-autopass@wecam.addon",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://student.camu.in/v2/leaveManagement*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
