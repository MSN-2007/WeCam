{
  "manifest_version": 3,
  "name": "CAMU AutoPass – V3.4",
  "version": "3.4.0",
  "description": "CAMU weekend leave and gate-pass automation with preselected React-Select detection and semantic time validation and Thursday scheduling.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://student.camu.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CAMU AutoPass"
  },
  "content_scripts": [
    {
      "matches": [
        "https://student.camu.in/v2/leaveManagement*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}